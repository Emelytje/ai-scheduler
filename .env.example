# Copy to .env.local for local development; set the same names in Vercel → Project → Settings → Environment Variables.
# Leave the Supabase values empty to run in demo mode (sample data in the browser, no login).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment, e.g. https://ai-scheduler.vercel.app (used for OAuth redirects and webhooks)
APP_URL=http://localhost:3000

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: $APP_URL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# At least 32 random characters: openssl rand -hex 32
EMBED_SIGNING_SECRET=
# Origins allowed to iframe /embed, space separated, e.g. https://app.example.com https://sellers.example.com
EMBED_ALLOWED_ORIGINS=

# Random secret; Vercel Cron sends it as a bearer token: openssl rand -hex 32
CRON_SECRET=

# Slack (optional). Create the app at api.slack.com/apps → "From a manifest" using $APP_URL/api/slack/manifest,
# then copy from "Basic Information": Client ID, Client Secret and Signing Secret.
# Slack also uses TOKEN_ENCRYPTION_KEY (bot tokens) and EMBED_SIGNING_SECRET (account-link links).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
