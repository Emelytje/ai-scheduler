{
  "name": "ai-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build-preview.mjs && vitest run -c vitest.e2e.config.ts",
    "build:preview": "node scripts/build-preview.mjs",
    "test:db": "for f in supabase/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q -f \"$f\" || exit 1; done && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/db_test.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "jose": "^6.2.13",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "supabase": "^2.122.0",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
}
